{
  "name": "deutsch-wordle-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "bundle:android": "expo export --platform android --output-dir .expo-export",
    "prebuild": "expo prebuild --platform android --clean",
    "apk": "expo prebuild --platform android --clean && node scripts/gradle.mjs assembleRelease",
    "apk:arm64": "expo prebuild --platform android --clean && node scripts/gradle.mjs assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "apk:cloud": "eas build --platform android --profile preview"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.23",
    "expo-clipboard": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
